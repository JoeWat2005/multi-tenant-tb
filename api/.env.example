# Claude Trader v2 API — environment template.
# Copy to `.env` in this folder and fill in at minimum ANTHROPIC_API_KEY
# and the three CLERK_* values. Everything else has a safe default.

# ── AI ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Clerk (auth) ──────────────────────────────────────────────────────────
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./crypto_bot_v2.db

# Dev-only: drop + recreate every table on startup. Set to `false` once you
# want sessions + history to survive server restarts.
RESET_DB_ON_STARTUP=true

# ── Trading defaults ──────────────────────────────────────────────────────
# Overridden per-tenant via the BotConfig row (PUT /api/bot/config). These
# are only the initial values for new rows.
PAPER_TRADING=true
DEFAULT_PAPER_BALANCE=10000
TAKER_FEE_RATE=0.001

# Emergency kill — when `true`, RiskService forces every decision to HOLD.
# Read at evaluation time; no restart needed.
KILL_SWITCH=false

# ── Alpaca ────────────────────────────────────────────────────────────────
# Get paper keys from https://alpaca.markets (paper trading account).
# The same keys work for both paper and live — mode is picked per-tenant
# via BotConfig.mode (PAPER routes to paper-api.alpaca.markets).
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Global safety flag: when true, even a tenant with mode=LIVE gets routed
# to the paper endpoint. Flip to false only when you're ready for real $.
ALPACA_PAPER=true
